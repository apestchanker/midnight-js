{
  "name": "@midnight-ntwrk/midnight-js-nextjs",
  "version": "4.0.4",
  "description": "Next.js integration helpers for midnight-js: webpack config, Turbopack WASM compatibility",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./patch-wasm": "./scripts/patch-wasm-turbopack.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "midnight-patch-wasm": "./scripts/patch-wasm-turbopack.mjs"
  },
  "repository": "git@github.com:midnight-ntwrk/artifacts",
  "packageManager": "yarn@4.14.1",
  "author": "IOHK",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo .rollup.cache reports coverage",
    "build": "rollup -c rollup.config.mjs",
    "test": "vitest run",
    "deploy": "yarn npm publish --tolerate-republish"
  },
  "files": [
    "dist/",
    "scripts/"
  ],
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": false
    }
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.0.0",
    "next": "^15.0.0",
    "rollup": "^4.60.1",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "sideEffects": false
}
